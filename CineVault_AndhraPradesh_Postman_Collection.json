              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Avengers: Doomsday\",\n  \"description\": \"Earth mightiest heroes face Doctor Doom across the multiverse.\",\n  \"duration\": 182,\n  \"language\": \"English\",\n  \"genre\": [\"Action\", \"Sci-Fi\", \"Superhero\"],\n  \"releaseDate\": \"2026-05-01\",\n  \"posterUrl\": \"/posters/avengers-doomsday.jpg\",\n  \"trailerUrl\": \"https://www.youtube.com/watch?v=YoHD9XEInc0\",\n  \"rating\": 9.4\n}"
            },
            "url": {
              "raw": "{{base_url}}/movies/add",
              "host": [
                "{{base_url}}"
              ],
              "path": [
