    {
      "name": "4. Shows",
      "item": [
        {
          "name": "Get All Shows",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.shows && json.shows.length > 0) {",
                  "  pm.collectionVariables.set('show_id', json.shows[0]._id);",
                  "  console.log('Saved show_id:', json.shows[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/shows/all",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shows",
                "all"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. User Booking Flow",
      "item": [
        {
          "name": "Lock Seats (5-Min Hold)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"show\": \"{{show_id}}\",\n  \"seats\": [\"C1\", \"C2\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/seat-lock/lock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "seat-lock",
                "lock"
              ]
            }
          }
        },
        {
          "name": "Create Booking with F&B Snacks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.booking) {",
                  "  pm.collectionVariables.set('booking_id', json.booking._id);",
                  "  console.log('Saved booking_id:', json.booking._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"show\": \"{{show_id}}\",\n  \"seats\": [\"C1\", \"C2\"],\n  \"totalAmount\": 890,\n  \"snacks\": [\n    {\n      \"id\": \"popcorn-salted\",\n      \"name\": \"Classic Salted Popcorn (Tub)\",\n      \"quantity\": 1,\n      \"price\": 220\n    }\n  ],\n  \"snackTotal\": 220,\n  \"discount\": 50,\n  \"couponCode\": \"CINE50\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings/create",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "create"
              ]
            }
          }
        },
        {
          "name": "Confirm Booking & Payment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/confirm/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "confirm",
                "{{booking_id}}"
              ]
            }
          }
        },
        {
          "name": "Gatekeeper / Usher QR Ticket Scanner Check-In",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/check-in/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "check-in",
                "{{booking_id}}"
              ]
            }
          }
        },
        {
          "name": "Cancel Booking & Free Seats",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/cancel/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "cancel",
                "{{booking_id}}"
              ]
            }
          }
        }
      ]
    }
  ]
