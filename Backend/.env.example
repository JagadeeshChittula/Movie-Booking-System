# CineVault Backend Environment Configuration Template
# Copy this file to .env and replace the placeholder values.

# Server Port
PORT=4000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cinevault?retryWrites=true&w=majority
MONGODB=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cinevault?retryWrites=true&w=majority

# JSON Web Token Secret (generate a strong random secret)
JWT_SECRET=your_jwt_secret_key_here

# Admin Seeder Defaults (optional, used by populate-via-api.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
